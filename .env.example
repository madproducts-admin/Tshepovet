# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8080
# App connects as a NON-superuser member of tshepovet_app so RLS is enforced.
DATABASE_URL=postgres://tshepovet_api:apipass@localhost:5432/tshepovet_dev
WORKER_DATABASE_URL=postgres://tshepovet_owner:devpass@localhost:5432/tshepovet_dev
REDIS_URL=redis://localhost:6379/0

# --- Crypto ------------------------------------------------------------------
# Local KEKs for envelope encryption, "version:base64key" comma-separated; the
# highest version encrypts. Production: replace LocalKeyProvider with AWS KMS
# (af-south-1) - see src/lib/crypto.ts.
KEK_KEYS=1:REPLACE_WITH_32_BYTE_BASE64
# Root key for HMAC blind indexes (HKDF-derived per purpose / per tenant).
BLIND_INDEX_ROOT_KEY=REPLACE_WITH_32_BYTE_BASE64
# Pepper for API-key hashing.
API_KEY_PEPPER=REPLACE_WITH_32_BYTE_BASE64

# --- Verification ------------------------------------------------------------
# Comma-separated provider codes enabled in this environment.
ENABLED_PROVIDERS=mock
SYNC_DEADLINE_MS=8000
# Max bureau spend per R3.00 company check before we stop falling through.
COMPANY_CHECK_COST_CEILING_CENTS=240

# --- Bureau credentials (never commit real values) ----------------------------
XDS_BASE_URL=
XDS_API_KEY=
CPB_BASE_URL=
CPB_API_KEY=
SEARCHWORKS_BASE_URL=
SEARCHWORKS_API_KEY=
VERIFYID_BASE_URL=
VERIFYID_API_KEY=

# --- WhatsApp Cloud API --------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# --- LLM / OCR ---------------------------------------------------------------
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5-5
