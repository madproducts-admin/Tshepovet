{
  "name": "tshepovet",
  "version": "0.1.0",
  "private": true,
  "description": "TshepoVet - low-cost B2B vendor onboarding, KYB and continuous compliance for South Africa",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker:webhooks": "tsx src/workers/webhookDispatcher.ts",
    "worker:purge": "tsx src/workers/retentionPurge.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:seed": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^4.22.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
