{
  "name": "tshepovet",
  "version": "0.2.0",
  "private": true,
  "description": "TshepoVet - low-cost B2B vendor onboarding, KYB and continuous compliance for South Africa",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/contracts apps/api",
    "typecheck": "tsc -b packages/core packages/contracts apps/api",
    "clean": "tsc -b --clean packages/core packages/contracts apps/api",
    "start": "node apps/api/dist/main.js",
    "start:worker": "node apps/api/dist/worker.js",
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:worker": "tsx watch apps/api/src/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:integration": "vitest run apps/api/test/integration",
    "test:unit:no-services": "vitest run packages --exclude packages/core/test/waterfall.test.ts",
    "site:build": "node tools/build-site.mjs && node tools/assemble-deploy.mjs",
    "site:smoke": "playwright test tests/smoke/site.smoke.ts",
    "app:smoke": "playwright test tests/smoke/api.smoke.ts",
    "site:smoke:local": "node tools/smoke-local.mjs",
    "deploy": "node tools/deploy.mjs",
    "deploy:dry": "node tools/deploy.mjs --dry-run",
    "web:dev": "npm run dev --workspace @tshepovet/web",
    "web:build": "npm run build --workspace @tshepovet/web",
    "web:typecheck": "npm run typecheck --workspace @tshepovet/web",
    "web:test": "playwright test -c apps/web/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "mermaid": "11.17.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
