<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site "tshepovet" (https://tshepovet.madproducts.ai), proxy only: no files are served.
  deploy/app/deploy-app.ps1 copies this file into each release and writes the live release's
  copy to D:\sites\tshepovet on every switch (a rollback writes the earlier release's copy);
  edit it here, never there.

  Cloudflare sends /docs* and /robots.txt to the tshepovet-site Worker (the docs), so they
  never arrive here. Through ARR (enabled server-wide):
    /api, /v1, /webhooks, /healthz, /readyz  -> the API, tshepovet-api on 127.0.0.1:9131
    everything else, "/" included             -> the web app, tshepovet-web on 127.0.0.1:9132
  X-Forwarded-Host and X-Forwarded-Proto tell both who the visitor asked for (install-box.ps1
  allows the two server variables on this site).

  Security headers: each backend sends its own (the API a JSON-only policy, the web app a
  per-page nonce policy), so IIS adds only what both share: HSTS and X-Robots-Tag (the
  sandbox is never indexed). Adding a Content-Security-Policy here would double the web
  app's and block its pages.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="the API" stopProcessing="true">
          <match url="^(api|v1|webhooks)(/.*)?$|^(healthz|readyz)$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:9131/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="everything else to the web app" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:9132/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
      <outboundRules>
        <!-- ARR adds "X-Powered-By: ARR/3.0" after customHeaders run, so <remove> below
             cannot reach it; blanking it here drops it. -->
        <rule name="hide the ARR banner">
          <match serverVariable="RESPONSE_X_POWERED_BY" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
      </customHeaders>
    </httpProtocol>
    <security>
      <!-- The API caps JSON bodies at 256 KB itself; refuse anything far larger here. -->
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
    <!-- Pass the backends' own error responses through instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
