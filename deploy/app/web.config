<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site "tshepovet" (https://tshepovet.madproducts.ai), proxy only: no files are served.
  Copied to D:\sites\tshepovet by deploy/app/install-box.ps1; edit it here, not there.

  Cloudflare sends /docs* and /robots.txt to the tshepovet-site Worker (the docs), so they
  never arrive here. "/" redirects to the docs; everything else goes to the API service on
  loopback (tshepovet-api, 127.0.0.1:9131) through ARR, which is enabled server-wide.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="root to the docs" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/docs/" redirectType="Found" />
        </rule>
        <rule name="everything else to the API" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:9131/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
      <outboundRules>
        <!-- ARR adds "X-Powered-By: ARR/3.0" after customHeaders run, so <remove> below
             cannot reach it; blanking it here drops it. -->
        <rule name="hide the ARR banner">
          <match serverVariable="RESPONSE_X_POWERED_BY" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="no-referrer" />
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <add name="Content-Security-Policy" value="default-src 'none'; frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>
    <security>
      <!-- The API caps JSON bodies at 256 KB itself; refuse anything far larger here. -->
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>
    <!-- Pass the API's own problem+json errors through instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
